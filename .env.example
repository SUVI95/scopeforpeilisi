# Server-side only — never exposed to the client.

# Anthropic (optional — legacy chat route)
ANTHROPIC_API_KEY=

# Neon Postgres — discovery questionnaire responses
# Create project at https://console.neon.tech then run db/schema.sql
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret for viewing responses at /admin/discovery
DISCOVERY_ADMIN_SECRET=change-me-to-a-long-random-string

# Email when Peilisi completes the questionnaire (optional but recommended)
# Sign up at https://resend.com — verify hsbridgeai.fi domain for production sends
DISCOVERY_NOTIFY_EMAIL=suvi@hsbridgeai.fi
RESEND_API_KEY=
RESEND_FROM=HSBridge <notifications@hsbridgeai.fi>

# Or webhook (Slack, Zapier, Make, etc.) on completion
DISCOVERY_WEBHOOK_URL=

# Used in completion notification links
SITE_URL=https://scopepeilisi.hsbridgeai.fi
